# Copy this file to .env and fill in your own values.
# .env is gitignored and is the ONLY place secrets live — never put them in files/config.json.

# LLM for letter extraction, as '<provider>:<model>' (any pydantic_ai provider). Unset -> google:gemini-3.6-flash.
#   MODEL=google:gemini-3.6-flash -> GEMINI_API_KEY or GOOGLE_API_KEY (https://aistudio.google.com/apikey, free tier)
#   MODEL=openai:gpt-4o           -> OPENAI_API_KEY (https://platform.openai.com/api-keys, paid)
# Another provider (e.g. anthropic:...) needs its pydantic-ai-slim extra in pyproject.toml and its key.
MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Resend API key (https://resend.com/api-keys) — only for the send job and local test sends.
RESEND_API_KEY=

# Cloud callers use the authenticated Israeli Knesset fetch service; unset URL keeps local direct fetching.
KNESSET_FETCH_URL=
KNESSET_FETCH_TOKEN=

# Shared by the Flask scheduler endpoint and Neon Function. Generate a random secret.
SCHEDULER_SECRET=
# Neon Function only: full HTTPS URL ending in /api/internal/scheduler/tick.
SCHEDULER_TICK_URL=

# APP_ENV=test loads .env.test (Neon test branch URLs) over this file:
#   APP_ENV=test flask --app web.app run --port 5001
